-- WARNING: This schema is for context only and is not meant to be run.
-- Table order and constraints may not be valid for execution.

CREATE TABLE public.ai_rapports (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  journee_id uuid,
  date date NOT NULL,
  score_performance integer CHECK (score_performance >= 0 AND score_performance <= 100),
  verdict_flash text,
  rapport_json jsonb NOT NULL DEFAULT '{}'::jsonb,
  statut text NOT NULL DEFAULT 'en_cours'::text CHECK (statut = ANY (ARRAY['en_cours'::text, 'genere'::text, 'erreur'::text])),
  erreur_msg text,
  modele_ia text DEFAULT 'glm-4-flash'::text,
  tokens_utilises integer,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  meteo_id uuid,
  feedback_vendeuse text,
  evenement_lendemain text,
  consignes_boulanger text,
  consignes_vendeuse text,
  wizard_evenement text,
  wizard_impact text,
  wizard_impact_pct integer DEFAULT 0,
  CONSTRAINT ai_rapports_pkey PRIMARY KEY (id),
  CONSTRAINT ai_rapports_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id),
  CONSTRAINT ai_rapports_journee_id_fkey FOREIGN KEY (journee_id) REFERENCES public.journees(id),
  CONSTRAINT ai_rapports_meteo_id_fkey FOREIGN KEY (meteo_id) REFERENCES public.meteo_journees(id)
);
CREATE TABLE public.audit_equipe (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  acteur_id uuid,
  cible_id uuid,
  action text NOT NULL,
  details jsonb DEFAULT '{}'::jsonb,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT audit_equipe_pkey PRIMARY KEY (id),
  CONSTRAINT audit_equipe_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id),
  CONSTRAINT audit_equipe_acteur_id_fkey FOREIGN KEY (acteur_id) REFERENCES auth.users(id)
);
CREATE TABLE public.boulangeries (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid,
  nom text NOT NULL,
  slug text NOT NULL UNIQUE,
  email_contact text,
  plan text DEFAULT 'starter'::text CHECK (plan = ANY (ARRAY['starter'::text, 'pro'::text, 'multi'::text])),
  actif boolean DEFAULT true,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  stripe_customer_id text,
  stripe_subscription_id text,
  trial_ends_at timestamp with time zone,
  stripe_status text NOT NULL DEFAULT 'inactive'::text CHECK (stripe_status = ANY (ARRAY['inactive'::text, 'trialing'::text, 'active'::text, 'past_due'::text, 'canceled'::text, 'unpaid'::text])),
  tour_completed_at timestamp with time zone,
  flash_heure_debut integer NOT NULL DEFAULT 18 CHECK (flash_heure_debut >= 0 AND flash_heure_debut <= 23),
  flash_heure_fin integer NOT NULL DEFAULT 20 CHECK (flash_heure_fin >= 1 AND flash_heure_fin <= 24),
  flash_remise_pct integer NOT NULL DEFAULT 40 CHECK (flash_remise_pct >= 1 AND flash_remise_pct <= 100),
  adresse text,
  ville text,
  code_postal text CHECK (code_postal IS NULL OR code_postal ~ '^\d{5}$'::text),
  telephone text,
  creneaux_retrait ARRAY DEFAULT ARRAY['08:00'::text, '09:00'::text, '10:00'::text],
  timezone text NOT NULL DEFAULT 'Europe/Paris'::text,
  latitude numeric,
  longitude numeric,
  pays text NOT NULL DEFAULT 'FR'::text,
  levain_quota_week_start date,
  levain_quota_used integer DEFAULT 0,
  CONSTRAINT boulangeries_pkey PRIMARY KEY (id),
  CONSTRAINT boulangeries_user_id_fkey FOREIGN KEY (user_id) REFERENCES auth.users(id)
);
CREATE TABLE public.commandes (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  client_prenom text NOT NULL CHECK (length(client_prenom) >= 1 AND length(client_prenom) <= 50),
  client_email text NOT NULL CHECK (client_email ~* '^[^@]+@[^@]+\.[^@]+$'::text),
  client_telephone text,
  heure_retrait time without time zone NOT NULL,
  notes text CHECK (length(notes) <= 500),
  montant_total numeric NOT NULL CHECK (montant_total > 0::numeric),
  statut text NOT NULL DEFAULT 'en_attente'::text CHECK (statut = ANY (ARRAY['en_attente'::text, 'confirmee'::text, 'prete'::text, 'recuperee'::text, 'annulee'::text])),
  lignes jsonb NOT NULL DEFAULT '[]'::jsonb,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT commandes_pkey PRIMARY KEY (id),
  CONSTRAINT commandes_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id)
);
CREATE TABLE public.employes (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  user_id uuid,
  role text NOT NULL DEFAULT 'employe'::text CHECK (role = ANY (ARRAY['gerant'::text, 'employe'::text])),
  permissions jsonb NOT NULL DEFAULT '{}'::jsonb,
  statut text NOT NULL DEFAULT 'invite'::text CHECK (statut = ANY (ARRAY['invite'::text, 'actif'::text, 'suspendu'::text])),
  invite_email text NOT NULL CHECK (invite_email ~* '^[^@]+@[^@]+\.[^@]+$'::text),
  invite_token text UNIQUE,
  invite_expires_at timestamp with time zone,
  created_by uuid,
  prenom text,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT employes_pkey PRIMARY KEY (id),
  CONSTRAINT employes_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id),
  CONSTRAINT employes_user_id_fkey FOREIGN KEY (user_id) REFERENCES auth.users(id),
  CONSTRAINT employes_created_by_fkey FOREIGN KEY (created_by) REFERENCES auth.users(id)
);
CREATE TABLE public.feedback_journee (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  journee_id uuid NOT NULL UNIQUE,
  boulangerie_id uuid NOT NULL,
  rating_journee integer NOT NULL CHECK (rating_journee >= 1 AND rating_journee <= 4),
  points_forts ARRAY DEFAULT '{}'::text[],
  points_ameliorer ARRAY DEFAULT '{}'::text[],
  commentaire_libre text CHECK (length(commentaire_libre) <= 1000),
  has_evenement boolean DEFAULT false,
  evenement_desc text CHECK (length(evenement_desc) <= 500),
  evenement_impact text CHECK (evenement_impact = ANY (ARRAY['hausse'::text, 'baisse'::text, NULL::text])),
  evenement_pct integer DEFAULT 0 CHECK (evenement_pct >= 0 AND evenement_pct <= 100),
  saisi_par_id uuid,
  saisi_par_prenom text,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT feedback_journee_pkey PRIMARY KEY (id),
  CONSTRAINT feedback_journee_journee_id_fkey FOREIGN KEY (journee_id) REFERENCES public.journees(id),
  CONSTRAINT feedback_journee_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id),
  CONSTRAINT feedback_journee_saisi_par_id_fkey FOREIGN KEY (saisi_par_id) REFERENCES auth.users(id)
);
CREATE TABLE public.journees (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  date date NOT NULL,
  commandes_online integer DEFAULT 0,
  ca_estime numeric DEFAULT 0,
  taux_invendu numeric DEFAULT 0,
  total_produit integer DEFAULT 0,
  total_invendu integer DEFAULT 0,
  cloturee boolean DEFAULT false,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  matin_validated boolean NOT NULL DEFAULT false,
  nb_fournees integer NOT NULL DEFAULT 1,
  feedback_vendeuse text,
  evenement_lendemain text,
  CONSTRAINT journees_pkey PRIMARY KEY (id),
  CONSTRAINT journees_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id)
);
CREATE TABLE public.meteo_journees (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  date date NOT NULL,
  temperature_c numeric,
  ressenti_c numeric,
  humidite_pct smallint,
  precipitations_mm numeric,
  vitesse_vent_kmh numeric,
  code_meteo smallint,
  description text,
  icone text,
  demain_temp_max_c numeric,
  demain_temp_min_c numeric,
  demain_precip_mm numeric,
  demain_code_meteo smallint,
  demain_description text,
  demain_icone text,
  source text NOT NULL DEFAULT 'open-meteo'::text,
  fetched_at timestamp with time zone NOT NULL DEFAULT now(),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT meteo_journees_pkey PRIMARY KEY (id),
  CONSTRAINT meteo_journees_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id)
);
CREATE TABLE public.paniers_flash (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  date date NOT NULL DEFAULT CURRENT_DATE,
  produit_id text NOT NULL,
  produit_nom text NOT NULL CHECK (length(produit_nom) >= 1 AND length(produit_nom) <= 150),
  produit_emoji text NOT NULL DEFAULT '🥖'::text,
  categorie text NOT NULL DEFAULT 'boulangerie'::text CHECK (categorie = ANY (ARRAY['boulangerie'::text, 'viennoiserie'::text, 'patisserie'::text, 'sandwich'::text])),
  prix_original numeric NOT NULL CHECK (prix_original > 0::numeric),
  remise_pct integer NOT NULL DEFAULT 40 CHECK (remise_pct >= 1 AND remise_pct <= 100),
  prix_flash numeric NOT NULL CHECK (prix_flash > 0::numeric),
  quantite_initiale integer NOT NULL DEFAULT 1 CHECK (quantite_initiale >= 0),
  quantite_restante integer NOT NULL DEFAULT 1 CHECK (quantite_restante >= 0),
  allergenes ARRAY NOT NULL DEFAULT '{}'::text[],
  actif boolean NOT NULL DEFAULT true,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT paniers_flash_pkey PRIMARY KEY (id),
  CONSTRAINT paniers_flash_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id)
);
CREATE TABLE public.production_forecasts (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  rapport_id uuid,
  date_production date NOT NULL,
  produit_id text NOT NULL,
  produit_nom text NOT NULL,
  produit_categorie text DEFAULT 'boulangerie'::text,
  produit_emoji text DEFAULT '🥖'::text,
  quantite_suggeree integer NOT NULL CHECK (quantite_suggeree >= 0),
  quantite_base integer NOT NULL DEFAULT 0,
  variation_pct integer DEFAULT 0,
  raison text,
  appliquee boolean DEFAULT false,
  appliquee_le timestamp with time zone,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT production_forecasts_pkey PRIMARY KEY (id),
  CONSTRAINT production_forecasts_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id),
  CONSTRAINT production_forecasts_rapport_id_fkey FOREIGN KEY (rapport_id) REFERENCES public.ai_rapports(id)
);
CREATE TABLE public.produits (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  nom text NOT NULL CHECK (length(nom) >= 1 AND length(nom) <= 100),
  description text CHECK (length(description) <= 500),
  categorie text NOT NULL DEFAULT 'boulangerie'::text CHECK (categorie = ANY (ARRAY['boulangerie'::text, 'viennoiserie'::text, 'patisserie'::text, 'sandwich'::text])),
  emoji text DEFAULT '🥖'::text,
  prix_vente numeric NOT NULL CHECK (prix_vente > 0::numeric),
  cout_production numeric DEFAULT 0,
  image_url text,
  image_storage_path text,
  actif boolean DEFAULT true,
  ordre integer DEFAULT 0,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  actif_catalogue boolean DEFAULT true,
  actif_flash boolean DEFAULT true,
  prix_flash_override numeric DEFAULT NULL::numeric CHECK (prix_flash_override IS NULL OR prix_flash_override > 0::numeric),
  allergenes ARRAY DEFAULT '{}'::text[],
  disponible_du date,
  disponible_au date,
  stock_alerte integer,
  note_interne text,
  deleted_at timestamp with time zone,
  CONSTRAINT produits_pkey PRIMARY KEY (id),
  CONSTRAINT produits_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id)
);
CREATE TABLE public.profils_clients (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL UNIQUE,
  prenom text NOT NULL CHECK (length(prenom) >= 1 AND length(prenom) <= 50),
  telephone text CHECK (telephone IS NULL OR length(telephone) >= 8 AND length(telephone) <= 20),
  optin_flash boolean DEFAULT false,
  optin_marketing boolean DEFAULT false,
  rgpd_accepted_at timestamp with time zone NOT NULL DEFAULT now(),
  rgpd_version text NOT NULL DEFAULT '1.0'::text,
  profil_completed boolean DEFAULT false,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT profils_clients_pkey PRIMARY KEY (id),
  CONSTRAINT profils_clients_user_id_fkey FOREIGN KEY (user_id) REFERENCES auth.users(id)
);
CREATE TABLE public.push_subscriptions (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  boulangerie_id uuid NOT NULL,
  user_id uuid NOT NULL,
  endpoint text NOT NULL UNIQUE,
  p256dh text,
  auth_key text,
  subscription jsonb,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT push_subscriptions_pkey PRIMARY KEY (id),
  CONSTRAINT push_subscriptions_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id),
  CONSTRAINT push_subscriptions_user_id_fkey FOREIGN KEY (user_id) REFERENCES auth.users(id)
);
CREATE TABLE public.stocks_journaliers (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  journee_id uuid NOT NULL,
  boulangerie_id uuid NOT NULL,
  produit_id text NOT NULL,
  produit_nom text NOT NULL,
  produit_emoji text DEFAULT '🥖'::text,
  categorie text DEFAULT 'boulangerie'::text,
  prix_vente numeric DEFAULT 0,
  cout_production numeric DEFAULT 0,
  production integer DEFAULT 0,
  snapshot_10h integer DEFAULT 0,
  snapshot_10h_done boolean DEFAULT false,
  snapshot_14h integer DEFAULT 0,
  snapshot_14h_done boolean DEFAULT false,
  stock_final integer DEFAULT 0,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT stocks_journaliers_pkey PRIMARY KEY (id),
  CONSTRAINT stocks_journaliers_journee_id_fkey FOREIGN KEY (journee_id) REFERENCES public.journees(id),
  CONSTRAINT stocks_journaliers_boulangerie_id_fkey FOREIGN KEY (boulangerie_id) REFERENCES public.boulangeries(id)
);